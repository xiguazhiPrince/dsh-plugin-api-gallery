{
  "name": "dsh-plugin-api-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "43 distributed Slot demos plus a non-UI interface reference page for DSH plugin authors.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "catalog.json",
    "non-ui-slots.json",
    "interfaces-reference.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
